# Telegram Bot API (от @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Client API (https://my.telegram.org → API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Сессия Telethon в формате StringSession (получить через `python generate_session.py`)
TELETHON_SESSION=

# Google AI Studio (https://aistudio.google.com → Get API key)
GEMINI_API_KEY=

# PostgreSQL (Railway → Postgres service → Variables → DATABASE_URL, публичный URL)
POSTGRES_URL=postgresql://postgres:fZonQCjWzxXbWiykTLErDlbJCRdnEHAB@postgres.railway.internal:5432/railway

# Время автодайджеста (HH:MM, Europe/Moscow). Утром и вечером.
DIGEST_TIME_MORNING=09:00
DIGEST_TIME_EVENING=21:00
# Дополнительно: дайджест каждые N часов в течение дня. 0 = выключено.
DIGEST_INTERVAL_HOURS=0

# 1 = полностью отключить семантический поиск (embeddings). Работает только ts-поиск по словам.
# Полезно если квота Gemini кончилась и бот валится. По умолчанию 0.
DISABLE_EMBEDDINGS=0

# Chat ID владельца бота (узнать после первого сообщения боту — см. логи)
OWNER_CHAT_ID=
