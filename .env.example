# Telegram Bot API (от @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Client API (https://my.telegram.org → API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Сессия Telethon в формате StringSession (получить через `python generate_session.py`)
TELETHON_SESSION=

# Google AI Studio (https://aistudio.google.com → Get API key)
GEMINI_API_KEY=

# PostgreSQL (Railway → Postgres service → Variables → DATABASE_URL, публичный URL)
POSTGRES_URL=

# Время автодайджеста (HH:MM, Europe/Moscow)
DIGEST_TIME_MORNING=09:00
DIGEST_TIME_EVENING=21:00

# Chat ID владельца бота (узнать после первого сообщения боту — см. логи)
OWNER_CHAT_ID=
